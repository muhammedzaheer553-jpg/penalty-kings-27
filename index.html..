<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Penalty Kings 27 | Pro eFootball Edition</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#050f0c;color:white;font-family:'Segoe UI',Arial,sans-serif;overflow-x:hidden}
header{text-align:center;padding:15px;background:linear-gradient(135deg,#0a241b,#06140f);border-bottom:2px solid #204c35;box-shadow:0 4px 20px rgba(0,0,0,0.6)}
h1{color:#ffe600;margin:0;font-size:clamp(24px,5vw,40px);letter-spacing:3px;text-shadow:0 0 15px rgba(255,230,0,0.4)}
header p{color:#a2c9b4;font-size:11px;letter-spacing:3px;margin-top:5px}
main{max-width:1150px;margin:auto;padding:12px}
.panel{background:linear-gradient(145deg,#0d2218,#091811);border:1px solid #2a523e;border-radius:16px;padding:15px;margin-bottom:14px;box-shadow:0 8px 25px rgba(0,0,0,0.4)}
.teams{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:block;color:#a2c9b4;font-size:11px;font-weight:bold;letter-spacing:1px;margin-bottom:6px}
select{width:100%;padding:12px;background:#133323;color:white;border:1px solid #437059;border-radius:10px;font-size:14px;outline:none;cursor:pointer}
select:focus{border-color:#ffe600}
.scoreboard{display:grid;grid-template-columns:1fr auto 1fr;text-align:center;align-items:center;gap:10px}
.teamname{font-weight:bold;font-size:14px;color:#d4ede0;overflow-wrap:anywhere}
.score{font-size:48px;color:#ffe600;font-weight:900;text-shadow:0 0 12px rgba(255,230,0,0.3)}
.vs{font-size:13px;color:#7a9e8b;font-weight:bold}
#phase{text-align:center;color:#ffe600;font-weight:bold;font-size:12px;margin-top:10px;letter-spacing:1px}
#gamebox{position:relative;background:#030a07;border-radius:14px;overflow:hidden;border:2px solid #28543f;box-shadow:inset 0 0 30px rgba(0,0,0,0.8)}
#game{width:100%;height:clamp(320px,60vw,580px);display:block;touch-action:manipulation}
#loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#06140f;color:#ffe600;text-align:center;padding:20px;pointer-events:none;font-weight:bold;gap:10px}
.spinner{width:40px;height:40px;border:4px solid rgba(255,230,0,0.2);border-top-color:#ffe600;border-radius:50%;animation:spin 0.8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.hint{text-align:center;font-size:12px;color:#a2c9b4;padding-top:10px}
.player{display:flex;align-items:center;gap:14px}
.shirt{font-size:32px;background:#193d2c;padding:12px;border-radius:12px;border:1px solid #36664e}
.playername{font-size:18px;font-weight:bold;color:white}
.small{font-size:12px;color:#9bc4b0;margin-top:4px}
.power{display:flex;align-items:center;gap:14px;margin:16px 0}
.power label{margin:0}
.power input{flex:1;accent-color:#ffe600;height:6px;cursor:pointer}
button{border:0;border-radius:10px;padding:14px;font-weight:bold;cursor:pointer;transition:all 0.2s ease}
button:hover{transform:translateY(-1px);filter:brightness(1.1)}
button:active{transform:translateY(1px)}
button:disabled{opacity:.45;transform:none;filter:none;cursor:not-allowed}
.primary{background:linear-gradient(135deg,#ffe600,#e6cb00);color:#0d1a14;box-shadow:0 4px 15px rgba(255,230,0,0.3)}
.secondary{background:#234a37;color:white;border:1px solid #3b6e54}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:12px}
#message{text-align:center;min-height:45px;padding-top:14px;font-weight:bold;font-size:15px;color:#ffe600;text-shadow:0 0 10px rgba(255,230,0,0.2)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:center}
.stat{background:#133323;border-radius:10px;padding:14px 6px;border:1px solid #28543f}
.stat strong{display:block;color:#ffe600;font-size:25px}
.stat small{font-size:10px;color:#a2c9b4;letter-spacing:1px}
#players{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid #36664e;background:#133323;border-radius:20px;padding:8px 12px;font-size:11px;color:#b2d4c2}
.chip.done{opacity:.4;text-decoration:line-through}
.chip.active{background:#ffe600;color:#0d1a14;border-color:#ffe600;font-weight:bold;box-shadow:0 0 10px rgba(255,230,0,0.4)}
.rules{font-size:12px;line-height:1.7;color:#b2d4c2;margin-top:10px}
footer{text-align:center;color:#6b8c7b;font-size:11px;padding:25px;letter-spacing:1px}
@media(max-width:480px){main{padding:6px}.panel{padding:12px}.score{font-size:40px}.actions{grid-template-columns:1fr}}
</style>
</head>
<body>
<header>
  <h1>⚽ PENALTY KINGS 27</h1>
  <p>ULTIMATE eFOOTBALL 3D STADIUM EXPERIENCE</p>
</header>

<main>
<section class="panel">
  <div class="teams">
    <div>
      <label for="myTeam">YOUR TEAM</label>
      <select id="myTeam">
        <option>FC Barcelona</option><option>Real Madrid</option>
        <option>Manchester City</option><option>Liverpool</option>
        <option>Paris Saint-Germain</option><option>Argentina</option>
        <option>Brazil</option><option>France</option><option>Portugal</option><option>India</option>
      </select>
    </div>
    <div>
      <label for="opTeam">OPPONENT</label>
      <select id="opTeam">
        <option>Real Madrid</option><option>FC Barcelona</option>
        <option>Manchester City</option><option>Liverpool</option>
        <option>Paris Saint-Germain</option><option>Argentina</option>
        <option>Brazil</option><option>France</option><option>Portugal</option><option>India</option>
      </select>
    </div>
  </div>
</section>

<section class="panel">
  <div class="scoreboard">
    <div><div class="teamname" id="myName">FC Barcelona</div><div class="score" id="myScore">0</div></div>
    <div class="vs">VS</div>
    <div><div class="teamname" id="opName">Real Madrid</div><div class="score" id="opScore">0</div></div>
